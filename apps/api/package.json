{
  "name": "@checkout/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "build:lambda": "nest build --webpack --webpackPath webpack.lambda.config.cjs && tsx scripts/copy-lambda-assets.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest -c jest.config.ts",
    "test:cov": "jest -c jest.config.ts --coverage",
    "test:int": "sh -c 'jest -c jest.int.config.ts --runInBand'",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/shared/infrastructure/persistence/data-source.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/shared/infrastructure/persistence/data-source.ts",
    "migration:generate": "tsx node_modules/typeorm/cli.js migration:generate -d src/shared/infrastructure/persistence/data-source.ts",
    "seed": "tsx src/shared/infrastructure/persistence/seeds/seed.cli.ts",
    "seed:reset": "tsx src/shared/infrastructure/persistence/seeds/seed-reset.cli.ts",
    "reconcile:once": "nest start --entryFile workers/reconcile-once.cli",
    "email:preview": "tsx src/workers/email-preview.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@checkout/shared": "workspace:*",
    "@codegenie/serverless-express": "^4.16.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.156",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "csv-parse": "^7.0.3",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-node-externals": "^3.0.0"
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
